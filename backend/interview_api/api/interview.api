syntax = "v1"

info (
	title: "AI 面试 BFF API"
	desc:  "处理特定业务聚合逻辑、提供 HTTP 和 WebSocket 接口"
)

type CreateSessionReq {
	ResumeId     string `json:"resume_id"`
	JobProfileId string `json:"job_profile_id"`
}

type CreateSessionResp {
	SessionId string `json:"session_id"`
}

// --- User Auth ---
type RegisterReq {
	Username string `json:"username"`
	Email    string `json:"email"`
	Password string `json:"password"`
}

type RegisterResp {
	Id string `json:"id"`
}

type LoginReq {
	Email    string `json:"email"`
	Password string `json:"password"`
}

type LoginResp {
	Id    string `json:"id"`
	Token string `json:"token"`
}

type GetUserInfoResp {
	Id              string `json:"id"`
	Username        string `json:"username"`
	Email           string `json:"email"`
	DailyFreeTokens uint32 `json:"daily_free_tokens"`
	RechargeTokens  uint64 `json:"recharge_tokens"`
}

// --- Resume ---
type GenerateUploadUrlReq {
	Filename string `json:"filename"`
}

type GenerateUploadUrlResp {
	UploadUrl string `json:"upload_url"`
	ObjectKey string `json:"object_key"`
}

type CreateResumeReq {
	ObjectKey string `json:"object_key"`
}

type CreateResumeResp {
	Id     string `json:"id"`
	Status string `json:"status"`
}

type GetResumeReq {
	Id string `path:"id"`
}

type GetResumeResp {
	Id          string `json:"id"`
	RawText     string `json:"raw_text"`
	Status      string `json:"status"`
	CreatedAt   int64  `json:"created_at"`
	DownloadUrl string `json:"download_url"`
}

// --- Job Profile ---
type CreateJobProfileReq {
	Name        string `json:"name"`
	Description string `json:"description"`
}

type CreateJobProfileResp {
	Id string `json:"id"`
}

// --- Interview Session ---
type InterviewSession {
	SessionId    string `json:"session_id"`
	JobTitle     string `json:"job_title"`
	Status       string `json:"status"`
	CreatedAt    int64  `json:"created_at"`
	OverallScore int32  `json:"overall_score"`
}

type ListSessionsResp {
	Sessions []InterviewSession `json:"sessions"`
}

type GetSessionDetailReq {
	SessionId string `path:"session_id"`
}

type GetSessionDetailResp {
	SessionId    string `json:"session_id"`
	JobTitle     string `json:"job_title"`
	Transcript   string `json:"transcript"`
	OverallScore int32  `json:"overall_score"`
	Commentary   string `json:"commentary"`
}

type DeleteSessionReq {
	SessionId string `path:"session_id"`
}

type DeleteSessionResp {
	Success bool `json:"success"`
}

@server (
	prefix: /api/v1/user
)
service interview-api {
	@doc "用户注册"
	@handler Register
	post /register (RegisterReq) returns (RegisterResp)

	@doc "用户登录"
	@handler Login
	post /login (LoginReq) returns (LoginResp)
}

@server (
	prefix: /api/v1/user
	jwt:    Auth
)
service interview-api {
	@doc "获取当前用户信息"
	@handler GetUserInfo
	get /info returns (GetUserInfoResp)
}

@server (
	prefix: /api/v1/resumes
	jwt:    Auth
)
service interview-api {
	@doc "获取上传简历的预签名URL"
	@handler GenerateUploadUrl
	post /upload-url (GenerateUploadUrlReq) returns (GenerateUploadUrlResp)

	@doc "提交通知，触发简历解析入库"
	@handler CreateResume
	post / (CreateResumeReq) returns (CreateResumeResp)

	@doc "获取简历详情"
	@handler GetResume
	get /:id (GetResumeReq) returns (GetResumeResp)
}

@server (
	prefix: /api/v1/job-profiles
	jwt:    Auth
)
service interview-api {
	@doc "创建面试岗位"
	@handler CreateJobProfile
	post / (CreateJobProfileReq) returns (CreateJobProfileResp)
}

@server (
	prefix: /api/v1/interviews
	jwt:    Auth
)
service interview-api {
	@doc "创建面试会话"
	@handler CreateSession
	post / (CreateSessionReq) returns (CreateSessionResp)

	@doc "获取面试历史列表"
	@handler ListSessions
	get / returns (ListSessionsResp)

	@doc "获取面试详情"
	@handler GetSessionDetail
	get /:session_id (GetSessionDetailReq) returns (GetSessionDetailResp)

	@doc "删除面试记录"
	@handler DeleteSession
	delete /:session_id (DeleteSessionReq) returns (DeleteSessionResp)
}

